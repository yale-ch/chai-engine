{
  "id": "wf-ppl-csv",
  "type": "workflow.Workflow",
  "name": "Parse the names in a CSV of people",
  "steps": [
    {
      "id": "ppl_csv",
      "type": "provider.CsvFileProvider",
      "name": "People CSV Reader",
      "input": "inputs/people.csv",
      "settings": {
        "limit": 3
      },
      "steps": [
        {
          "id": "ppl_rows",
          "type": "iterator.SliceIterator",
          "name": "Row Iterator",
          "settings": {
            "continue_on_error": true,
            "retain_results": false,
            "max_slices": 1,
            "slice": 0
          },
          "steps": [
            {
              "id": "ppl_name",
              "type": "extractor.JsonXpathExtractor",
              "name": "Name Column Extractor",
              "settings": {
                "xpath": "/name"
              },
              "error_steps": [
                {
                  "id": "ppl_name_error_jsonl",
                  "type": "storage.JsonLinesStorage",
                  "name": "Failed Column JSON-Lines Writer",
                  "settings": {
                    "file": "results/people-parsed.jsonl",
                    "fields": {
                      "value": "error",
                      "metadata": "metadata"
                    },
                    "sources": {
                      "input": "ppl_rows"
                    }
                  }
                }
              ],
              "next_steps": [
                {
                  "id": "ppl_parsed",
                  "type": "extractor.TransformersExtractor",
                  "name": "Name Parser",
                  "settings": {
                    "model": "small-models-for-glam/Qwen3.5-4B-SFT-name-parser-yaml",
                    "tie_word_embeddings": false,
                    "prompt": "Parse this person name:\n\n{text_input_0}",
                    "expected_output": "yaml"
                  },
                  "error_steps": [
                    {
                      "id": "ppl_error_jsonl",
                      "type": "storage.JsonLinesStorage",
                      "name": "Failed Parse JSON-Lines Writer",
                      "settings": {
                        "file": "results/people-parsed.jsonl",
                        "fields": {
                          "value": "error",
                          "metadata": "metadata"
                        },
                        "sources": {
                          "input": "ppl_rows"
                        }
                      }
                    }
                  ],
                  "next_steps": [
                    {
                      "id": "ppl_jsonl",
                      "type": "storage.JsonLinesStorage",
                      "name": "Parsed Name JSON-Lines Writer",
                      "settings": {
                        "file": "results/people-parsed.jsonl",
                        "fields": {
                          "value": "parsed",
                          "metadata": "metadata"
                        },
                        "sources": {
                          "input": "ppl_rows"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
