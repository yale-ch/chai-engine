{
  "EmptyWorkflow": {
    "id": "_test_workflow",
    "type": "workflow.Workflow",
    "name": "Empty workflow",
    "steps": []
  },
  "PII_Transcriber": {
    "type": "provider.DirFileProvider",
    "steps": [
      {
        "id": "img_iter",
        "type": "iterator.Iterator",
        "name": "File Iterator",
        "steps": [
          {
            "id": "pii_classifier",
            "type": "classifier.FileTypeClassifier",
            "name": "Acceptable File Classifier",
            "register_on": [
              "img_iter"
            ]
          },
          {
            "type": "gate.LabelTestGate",
            "name": "Accepted File Gate",
            "settings": {
              "component": "pii_classifier",
              "label": [
                "accepted"
              ]
            },
            "true_steps": [
              {
                "type": "transcriber.GeminiTranscriber",
                "name": "Cloud Image Transcriber"
              }
            ],
            "false_steps": [
              {
                "type": "transcriber.LMStudioTranscriber",
                "name": "Local Image Transcriber",
                "settings": {
                  "model": "qwen/qwen3.5-9b"
                }
              }
            ]
          }
        ]
      }
    ],
    "next_steps": [
      {
        "id": "iter_debug",
        "type": "utils.DebugStep"
      }
    ]
  },
  "FileSystemStorage": {
    "type": "storage.FileSystemStorage",
    "settings": {
      "directory": "results"
    }
  },
  "JsonLinesStorage": {
    "type": "storage.JsonLinesStorage",
    "settings": {
      "file": "results/results.jsonl",
      "mode": "append"
    }
  },
  "ParquetStorage": {
    "type": "storage.ParquetStorage",
    "settings": {
      "file": "results/results-{run_id}.parquet",
      "compression": "snappy"
    }
  },
  "PostgresStorage": {
    "type": "storage.PostgresStorage",
    "settings": {
      "database": "chai",
      "table": "results"
    }
  },
  "ParquetStorageForPostgres": {
    "type": "storage.ParquetStorage",
    "settings": {
      "file": "results/results-{run_id}.parquet",
      "fields": {
        "id": "id",
        "processorId": "processor_id",
        "workflowId": "workflow_id",
        "@record": "value_json",
        "metadata": "metadata_json",
        "extraInfo": "extra_json",
        "@input_uri": "input_uri",
        "@input_hash": "input_hash",
        "@input_locator": "input_locator",
        "@corrects": "corrects_id"
      },
      "schema": {
        "id": "string",
        "processor_id": "string",
        "workflow_id": "string",
        "value_json": "json",
        "metadata_json": "json",
        "extra_json": "json",
        "input_uri": "string",
        "input_hash": "string",
        "input_locator": "json",
        "corrects_id": "string"
      },
      "null_if_empty": true,
      "run_columns": false
    }
  },
  "YoloDetectAndAnnotate": {
    "id": "yolo_detect",
    "type": "segmenter.YoloSegmenter",
    "name": "YOLO Detect + Annotated Preview",
    "settings": {
      "model": "yolo11n.pt",
      "confidence": 0.25
    },
    "next_steps": [
      {
        "id": "yolo_annotate",
        "type": "annotator.ImageBoxAnnotator",
        "name": "Annotated Detection Image"
      }
    ]
  }
}
