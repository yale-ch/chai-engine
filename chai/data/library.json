{
  "EmptyWorkflow": {
    "id": "_test_workflow",
    "type": "workflow.Workflow",
    "name": "Empty workflow",
    "steps": []
  },
  "PII_Transcriber": {
    "type": "provider.DirFileProvider",
    "steps": [
      {
        "id": "img_iter",
        "type": "iterator.Iterator",
        "name": "File Iterator",
        "steps": [
          {
            "id": "pii_classifier",
            "type": "classifier.FileTypeClassifier",
            "name": "Acceptable File Classifier",
            "register_on": [
              "img_iter"
            ]
          },
          {
            "type": "gate.LabelTestGate",
            "name": "Accepted File Gate",
            "settings": {
              "component": "pii_classifier",
              "label": [
                "accepted"
              ]
            },
            "true_steps": [
              {
                "type": "transcriber.GeminiTranscriber",
                "name": "Cloud Image Transcriber"
              }
            ],
            "false_steps": [
              {
                "type": "transcriber.LMStudioTranscriber",
                "name": "Local Image Transcriber",
                "settings": {
                  "model": "qwen/qwen3.5-9b"
                }
              }
            ]
          }
        ]
      }
    ],
    "next_steps": [
      {
        "id": "iter_debug",
        "type": "utils.DebugStep"
      }
    ]
  },
  "FileSystemStorage": {
    "type": "storage.FileSystemStorage",
    "settings": {
      "directory": "results"
    }
  },
  "JsonLinesStorage": {
    "type": "storage.JsonLinesStorage",
    "settings": {
      "file": "results/results.jsonl",
      "mode": "append"
    }
  },
  "ParquetStorage": {
    "type": "storage.ParquetStorage",
    "settings": {
      "file": "results/results-{run_id}.parquet",
      "compression": "snappy"
    }
  },
  "PostgresStorage": {
    "type": "storage.PostgresStorage",
    "settings": {
      "database": "chai"
    }
  },
  "YoloDetectRegions": {
    "id": "yolo_detect",
    "type": "segmenter.YoloSegmenter",
    "name": "YOLO Detect + Stored Regions",
    "settings": {
      "model": "yolo11n.pt",
      "confidence": 0.25,
      "crop": false
    },
    "next_steps": [
      {
        "id": "each_region",
        "type": "iterator.Iterator",
        "steps": [
          {
            "type": "storage.PostgresStorage",
            "settings": {
              "database": "chai"
            }
          }
        ]
      }
    ]
  },
  "LocateExtractedValues": {
    "id": "locate_values",
    "type": "segmenter.TextSpanLocator",
    "name": "Locate Extracted Values in Text",
    "next_steps": [
      {
        "id": "each_span",
        "type": "iterator.Iterator",
        "steps": [
          {
            "type": "storage.PostgresStorage",
            "settings": {
              "database": "chai"
            }
          }
        ]
      }
    ]
  }
}
